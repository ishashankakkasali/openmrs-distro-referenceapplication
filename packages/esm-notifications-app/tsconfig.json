{
  "extends": "openmrs/default",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "lib": ["dom", "es2017", "es2019", "es2020"],
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "es2020"
  },
  "include": ["src/**/*"]
}
