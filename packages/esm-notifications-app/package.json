{
  "name": "@openmrs/esm-notifications-app",
  "version": "1.0.0",
  "description": "Top-nav bell + dropdown that polls /ws/rest/v1/alert and surfaces notifications pushed by the receiver-adaptor.",
  "browser": "dist/openmrs-esm-notifications-app.js",
  "main": "src/index.ts",
  "source": true,
  "license": "MPL-2.0",
  "homepage": "https://github.com/openmrs/openmrs-distro-referenceapplication#readme",
  "scripts": {
    "start": "openmrs develop",
    "serve": "openmrs develop",
    "build": "webpack --mode production",
    "analyze": "webpack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx",
    "test": "jest --config jest.config.js --passWithNoTests",
    "typescript": "tsc"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
