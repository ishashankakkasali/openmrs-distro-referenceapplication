    "rxjs": "6.x"
  },
  "dependencies": {
    "@carbon/react": "^1.71.1",
    "clean-webpack-plugin": "^4.0.0",
    "lodash-es": "^4.17.21",
    "style-loader": "^4.0.0"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "browserslist-config-openmrs": "^1.0.1",
    "css-loader": "^7.1.2",
    "openmrs": "next",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "rxjs": "^6.6.7",
    "swc-loader": "^0.2.6",
