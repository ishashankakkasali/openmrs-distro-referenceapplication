<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.6//EN" "https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">
  <id>ecgai</id>
  <name>ECG AI</name>
  <version>${project.version}</version>
  <package>org.openmrs.module.ecgai</package>
  <author>O3 distro</author>
  <description>Reads an uploaded ECG with an LLM (Claude or Gemini) and saves the read on the ECG order.</description>
  <activator>org.openmrs.module.ecgai.EcgAiActivator</activator>
  <require_version>2.8.0</require_version>
  <require_modules>
    <require_module version="3.0.0">org.openmrs.module.webservices.rest</require_module>
  </require_modules>

  <!-- Environment variables of the same meaning (ECG_AI_PROVIDER, ECG_AI_MODEL, ...) win over these. The API key is
       read only from the environment (ECG_AI_API_KEY), never from a global property. -->
  <globalProperty>
    <property>ecgai.provider</property>
    <defaultValue>gemini</defaultValue>
    <description>LLM provider for the ECG read: gemini (Google Gemini) or anthropic (Claude). Env: ECG_AI_PROVIDER</description>
  </globalProperty>
  <globalProperty>
    <property>ecgai.model</property>
    <defaultValue></defaultValue>
    <description>Model id for the chosen provider; empty = the provider's default (gemini-3.1-pro-preview, claude-opus-5-5). Env: ECG_AI_MODEL</description>
  </globalProperty>
  <globalProperty>
    <property>ecgai.resultConceptUuid</property>
    <defaultValue>5a7d2c3e-1f4b-4c8a-9e6d-2b1f0c9a7e09</defaultValue>
    <description>Concept of the "ECG AI interpretation" observation (text). Env: ECG_AI_CONCEPT_UUID</description>
  </globalProperty>
</module>
