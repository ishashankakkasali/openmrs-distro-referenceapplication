# Copy to modules/ecgai/.env (git-ignored) and fill in. The backend reads it at start:
#   docker compose -p o3 -f docker-compose.yml -f docker-compose.override.yml up -d --no-build backend

# gemini (Google Gemini) or anthropic (Claude)
ECG_AI_PROVIDER=gemini

# API key of that provider:
#   gemini:    Google AI Studio, https://aistudio.google.com/apikey
#   anthropic: Claude Console, https://platform.claude.com (Settings > API keys)
ECG_AI_API_KEY=

# Model of that provider; empty = its default (gemini-3.1-pro-preview / claude-opus-5-5)
ECG_AI_MODEL=

# A file that replaces the bundled clinical prompt (optional; re-read on every read)
# ECG_AI_PROMPT_FILE=

# Concept of the "ECG AI interpretation" observation (created by scripts/imaging-orders-o3-setup.sh)
# ECG_AI_CONCEPT_UUID=5a7d2c3e-1f4b-4c8a-9e6d-2b1f0c9a7e09
