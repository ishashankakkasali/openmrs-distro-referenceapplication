{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "referrals-summary-dashboard",
      "component": "referralsDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "order": 99,
      "meta": {
        "slot": "patient-chart-referrals-dashboard-slot",
        "path": "Referrals",
        "title": "Referrals",
        "icon": "omrs-icon-list-checked"
      }
    },
    {
      "name": "referrals-details-widget",
      "component": "referralsDashboard",
      "slot": "patient-chart-referrals-dashboard-slot",
      "order": 0,
      "meta": {
        "title": "Referrals"
      }
    },
    {
      "name": "imaging-dashboard-link",
      "component": "imagingDashboardLink",
      "slot": "homepage-dashboard-slot",
      "meta": {
        "name": "imaging",
        "slot": "imaging-dashboard-slot",
        "title": "Imaging"
      }
    },
    {
      "name": "imaging-dashboard",
      "component": "imagingDashboard",
      "slot": "imaging-dashboard-slot"
    },
    {
      "name": "referrals-home-link",
      "component": "referralsHomeLink",
      "slot": "homepage-dashboard-slot",
      "meta": {
        "name": "referrals",
        "slot": "referrals-home-dashboard-slot",
        "title": "Referrals"
      }
    },
    {
      "name": "referrals-home",
      "component": "referralsHome",
      "slot": "referrals-home-dashboard-slot"
    },
    {
      "name": "imaging-results-dashboard",
      "component": "imagingResultsLink",
      "slot": "patient-chart-dashboard-slot",
      "order": 4,
      "meta": {
        "slot": "patient-chart-imaging-results-dashboard-slot",
        "path": "Imaging results",
        "title": "Imaging results",
        "icon": "omrs-icon-image-medical"
      }
    },
    {
      "name": "imaging-results-widget",
      "component": "imagingResults",
      "slot": "patient-chart-imaging-results-dashboard-slot",
      "order": 0,
      "meta": {
        "title": "Imaging results"
      }
    }
  ],
  "version": "1.0.0"
}
